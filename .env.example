# Optional integrations. Copy to .env.local for local dev; set the same names
# as GitHub Actions repository variables for production builds.

# Booking link for the "Book a call" buttons (hidden when empty)
NEXT_PUBLIC_BOOKING_URL=

# Plausible analytics domain, e.g. vertexmindai.com.au (disabled when empty)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
